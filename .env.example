# Dentist OS self-hosting configuration
NODE_ENV=production
PORT=4000

# Absolute path recommended on a mounted persistent disk.
DENTOS_DB_PATH=/var/lib/dentist-os/db.json

# Required before enabling scheduled reminders/recalls.
CRON_SECRET=replace-with-a-long-random-secret

# Required for real portal OTP delivery through MSG91.
# Never enable ALLOW_DEV_OTP in production.
OTP_PEPPER=replace-with-a-long-random-secret
# ALLOW_DEV_OTP=true   # local development only

# Optional tuning (milliseconds/counts)
# OTP_TTL_MS=300000
# OTP_RESEND_MS=60000
# OTP_MAX_ATTEMPTS=5
# OTP_REQUEST_LIMIT=5
# OTP_IP_LIMIT=15
# OTP_VERIFY_IP_LIMIT=30
# OTP_WINDOW_MS=600000
